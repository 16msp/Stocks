# Copy to .streamlit/secrets.toml (local) or paste into the Streamlit Community Cloud "Secrets" box.
# Never commit the real file.

POSITIONS_SHEET_URL = "https://docs.google.com/spreadsheets/d/<your-sheet-id>/edit"
APP_PASSWORD = "choose-a-password"          # optional: require a password to open the app
DATABASE_URL = "postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"  # optional: shared Postgres store (Supabase session pooler)
